#!/usr/bin/env python3
"""Deterministic fake AWS CLI for the SPEC 02.4 offline MFA tests.

The script never reads a real credential and never makes a network request. It
emits one of the reviewed source-session classifications selected by
``GOOTIP_MFA_TEST_SCENARIO`` and records every invocation in
``GOOTIP_MFA_TEST_LOG`` so a test can assert exactly which commands ran.

Supported commands:

* ``sts get-caller-identity`` -- source-session verification.
* ``configure get mfa_serial`` -- local MFA device ARN lookup.
* ``configure mfa-login`` -- simulated renewal; updates only ``gootip-mfa``.
"""

from __future__ import annotations

import json
import os
import shlex
import sys
from pathlib import Path


FIXTURE_ACCOUNT_ID = "000000000000"
FIXTURE_SOURCE_ARN = f"arn:aws:iam::{FIXTURE_ACCOUNT_ID}:user/gootip"

SUCCESS_SCENARIOS = {"valid", "missing", "expired"}
STOPPED_SCENARIOS = {"unreachable", "denied", "malformed", "missing-arn"}


def log_invocation(arguments: list[str]) -> None:
    log = os.environ.get("GOOTIP_MFA_TEST_LOG")
    if not log:
        return
    watched = (
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_SESSION_TOKEN",
        "AWS_SECURITY_TOKEN",
        "AWS_PROFILE",
    )
    leaked = [name for name in watched if os.environ.get(name)]
    marker = "clean" if not leaked else "leaked:" + ",".join(leaked)
    with open(log, "a", encoding="utf-8") as handle:
        handle.write(f"aws {shlex.join(arguments)} [env:{marker}]\n")


def sts_identity() -> int:
    scenario = os.environ.get("GOOTIP_MFA_TEST_SCENARIO", "valid")

    if scenario == "valid":
        print(
            json.dumps(
                {
                    "UserId": "AIDAFIXTURE000000000",
                    "Account": FIXTURE_ACCOUNT_ID,
                    "Arn": FIXTURE_SOURCE_ARN,
                }
            )
        )
        return 0

    if scenario == "missing":
        print(
            "The config profile (gootip-mfa) could not be found",
            file=sys.stderr,
        )
        return 255

    if scenario == "expired":
        print(
            "An error occurred (ExpiredToken) when calling the GetCallerIdentity "
            "operation: The security token included in the request is expired",
            file=sys.stderr,
        )
        return 255

    if scenario == "unreachable":
        print(
            'Could not connect to the endpoint URL: '
            '"https://sts.us-east-2.amazonaws.com/"',
            file=sys.stderr,
        )
        return 255

    if scenario == "denied":
        print(
            "An error occurred (AccessDenied) when calling the GetCallerIdentity "
            "operation: User is not authorized to perform: sts:GetCallerIdentity",
            file=sys.stderr,
        )
        return 255

    if scenario == "malformed":
        print(
            "An error occurred (InvalidClientTokenId) when calling the "
            "GetCallerIdentity operation: The security token included in the "
            "request is invalid.",
            file=sys.stderr,
        )
        return 255

    # Renewal-only scenarios start from a missing source session.
    print(
        "The config profile (gootip-mfa) could not be found",
        file=sys.stderr,
    )
    return 255


def configure_get(arguments: list[str]) -> int:
    # Only the serial lookup is modelled: configure get mfa_serial --profile NAME
    if "mfa_serial" not in arguments:
        print("fake-aws: unsupported configure get key", file=sys.stderr)
        return 64

    if os.environ.get("GOOTIP_MFA_TEST_SCENARIO") == "missing-arn":
        return 1

    serial = os.environ.get("GOOTIP_MFA_TEST_MFA_ARN", "")
    if not serial:
        return 1
    print(serial)
    return 0


def replace_section(text: str, section: str, body: str) -> str:
    """Replace one INI section, preserving every other section byte-for-byte."""
    kept: list[str] = []
    skipping = False

    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            skipping = stripped == f"[{section}]"
            if skipping:
                continue
        if skipping:
            continue
        kept.append(line)

    while kept and not kept[-1].strip():
        kept.pop()
    if kept:
        kept.append("")
    kept.append(f"[{section}]")
    kept.extend(body.splitlines())
    return "\n".join(kept) + "\n"


def configure_mfa_login(arguments: list[str]) -> int:
    scenario = os.environ.get("GOOTIP_MFA_TEST_SCENARIO", "valid")

    if scenario == "cancel":
        print("MFA token code: ", file=sys.stderr)
        print("MFA login cancelled.", file=sys.stderr)
        return 130

    if scenario in STOPPED_SCENARIOS:
        print(
            "fake-aws: mfa-login must not run for scenario " + scenario,
            file=sys.stderr,
        )
        return 99

    target = None
    for index, argument in enumerate(arguments):
        if argument == "--update-profile" and index + 1 < len(arguments):
            target = arguments[index + 1]
        elif argument.startswith("--update-profile="):
            target = argument.split("=", 1)[1]

    if target is None:
        print("fake-aws: missing --update-profile", file=sys.stderr)
        return 64

    credentials_path = Path(
        os.environ.get(
            "AWS_SHARED_CREDENTIALS_FILE",
            str(Path(os.environ.get("HOME", ".")) / ".aws" / "credentials"),
        )
    )
    existing = credentials_path.read_text() if credentials_path.exists() else ""

    body = "\n".join(
        [
            f"aws_access_key_id = {os.environ.get('GOOTIP_MFA_TEST_ACCESS_KEY_ID', 'AKIAFIXTURE0000000000')}",
            f"aws_secret_access_key = {os.environ.get('GOOTIP_MFA_TEST_SECRET_ACCESS_KEY', 'fixture-secret-access-key')}",
            f"aws_session_token = {os.environ.get('GOOTIP_MFA_TEST_SESSION_TOKEN', 'fixture-session-token-renewed')}",
        ]
    )
    credentials_path.write_text(replace_section(existing, target, body))

    print(f"Temporary credentials written to profile '{target}'")
    print("Credentials will expire at a fixture-controlled time")
    return 0


def main(arguments: list[str]) -> int:
    log_invocation(arguments)

    if "sts" in arguments and "get-caller-identity" in arguments:
        return sts_identity()

    if "configure" in arguments and "mfa-login" in arguments:
        return configure_mfa_login(arguments)

    if "configure" in arguments and "get" in arguments:
        return configure_get(arguments)

    print("fake-aws: unsupported command " + shlex.join(arguments), file=sys.stderr)
    return 64


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
