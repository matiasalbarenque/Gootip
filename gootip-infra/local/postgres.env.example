# Copy to postgres.env and replace each placeholder with a disposable local value.
POSTGRES_ADMIN_USER=gootip_local_admin
POSTGRES_ADMIN_PASSWORD=replace-with-local-admin-password
AUTH_MIGRATOR_PASSWORD=replace-with-auth-migrator-password
AUTH_RUNTIME_PASSWORD=replace-with-auth-runtime-password
CORE_MIGRATOR_PASSWORD=replace-with-core-migrator-password
CORE_RUNTIME_PASSWORD=replace-with-core-runtime-password
