{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "aws-knowledge": {
        "type": "remote",
        "url": "https://knowledge-mcp.global.api.aws"
      },
      "terraform": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "-i",
          "--rm",
          "hashicorp/terraform-mcp-server"
        ]
      }
    }
  }
}